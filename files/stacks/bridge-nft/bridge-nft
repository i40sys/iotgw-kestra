# Custom help function to include extra commands
help() {
    cat <<EOF
Usage: /etc/init.d/bridge-nft [command]

Commands:
  start     Start the service
  stop      Stop the service
  restart   Restart the service
  enable    Enable service autostart
  disable   Disable service autostart
  enabled   Check if service is enabled at boot
  status    Show current service status (running/stopped and enabled/disabled)
  dump      Dump the current nft ruleset
EOF
}
