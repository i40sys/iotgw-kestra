prometheus.exporter.cadvisor "cadvisor_export" {
  docker_host = "unix:///var/run/docker.sock"

  storage_duration = "1m"
}

// Configure a prometheus.scrape component to collect cadvisor metrics.
prometheus.scrape "cadvisor_scraper" {
  targets    = prometheus.exporter.cadvisor.cadvisor_export.targets
  forward_to = [ prometheus.remote_write.mimir_writer.receiver ]
  
  honor_timestamps = false
  scrape_timeout =  "30s"
  scrape_interval = "50s"
}

prometheus.exporter.unix "linux_exporter" { }

// Configure a prometheus.scrape component to collect unix metrics.
prometheus.scrape "linux_scraper" {
  targets    = prometheus.exporter.unix.linux_exporter.targets
  forward_to = [prometheus.remote_write.mimir_writer.receiver]

  honor_timestamps = false
  scrape_timeout = "30s"
  scrape_interval = "50s"
}

// getting metrics from service: docker_container_exporter
// repos: https://github.com/oriolrius/docker_container_exporter
prometheus.scrape "containers_exporter" {
  targets    = [
    { "__address__" = "localhost:{{ containers_exporter_port | default(9100) }}",
      "__scheme__" = "http",
      "instance" = constants.hostname,
      "job" = "containers_exporter",
      "__scrape_interval__" = "50s",
     },
  ]
  forward_to = [prometheus.remote_write.mimir_writer.receiver]

  honor_timestamps = false
  scrape_timeout =  "30s"
  scrape_interval = "50s"
}

{# Only when the uptime-kuma stack is on: Kuma's /metrics takes its admin login
   (no API keys are created, so basic auth uses the user account). #}
{% if uptime_kuma | default(true) | bool and autokuma_username is defined and autokuma_password is defined %}
// uptime-kuma metrics
prometheus.scrape "kuma_exporter" {
  targets    = [
    { "__address__" = "127.0.0.1:{{ uptime_kuma_port | default('3003') }}",
      "__scheme__" = "http",
      "__metrics_path__" = "/metrics",
      "instance" = constants.hostname,
      "job" = "kuma_exporter",
      "__scrape_interval__" = "50s",
     },
  ]
  basic_auth {
    username = {{ autokuma_username | to_json }}
    password = {{ autokuma_password | to_json }}
  }
  forward_to = [prometheus.remote_write.mimir_writer.receiver]

  honor_timestamps = false
  scrape_timeout =  "30s"
  scrape_interval = "50s"
}
{% endif %}
