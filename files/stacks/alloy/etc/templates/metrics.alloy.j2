prometheus.exporter.self "alloy" {}

prometheus.scrape "alloy" {
	targets    = prometheus.exporter.self.alloy.targets
	forward_to = [prometheus.remote_write.mimir_writer.receiver]

  scrape_timeout =  "30s"
  scrape_interval = "50s"
  honor_timestamps = false
}

