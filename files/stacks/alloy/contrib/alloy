#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
STOP=01

start_service() {
    logger -t alloy "Starting alloy service..."
    procd_open_instance
    procd_set_param command \
      /opt/stacks/alloy/bin/alloy \
      run \
      --storage.path=/opt/stacks/alloy/data \
      --server.http.listen-addr=0.0.0.0:12345 \
      --disable-reporting \
      --stability.level=experimental \
      /opt/stacks/alloy/etc
    procd_set_param respawn \
      ${respawn_threshold:-3600} \
      ${respawn_timeout:-5} ${respawn_retry:-5}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/alloy.pid
    procd_close_instance

    logger -t alloy "Alloy service started."
}

service_stopped() {
    logger -t alloy "Alloy service stopped."
}
