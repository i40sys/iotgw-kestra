TZ=Europe/Madrid
UPTIME_KUMA_PORT={{ uptime_kuma_port | default('3003') }}

# Kuma Configuration
UPTIME_KUMA_HIDE_LOG="debug_monitor,info_monitor,warn_monitor,info_auth,info_manage,info_socket,info_rate-limit"

# Autokuma Configuration. The same account is Uptime Kuma's admin (created by
# contrib/bootstrap-admin.js) and the basic auth Grafana Alloy scrapes /metrics with.
AUTOKUMA__KUMA__URL=http://127.0.0.1:{{ uptime_kuma_port | default('3003') }}
AUTOKUMA__KUMA__USERNAME='{{ autokuma_username }}'
AUTOKUMA__KUMA__PASSWORD='{{ autokuma_password }}'
AUTOKUMA__DOCKER__HOSTS=unix:///var/run/docker.sock
AUTOKUMA__DOCKER__LABEL_PREFIX=kuma

{% raw %}
# Container Snippet
AUTOKUMA__SNIPPETS__CONTAINER='
{{container_name}}.docker.name: {{args[0].name}}
{{container_name}}.docker.docker_container: {{container_name}}
{{container_name}}.docker.docker_host_name: local_socket
{{container_name}}.docker.parent_name: docker_containers
{{container_name}}.docker.description: {{args[0].description | default(value=container_name)}}
'
{% endraw %}

# Local Services Snippet: only the gateway's own services.
AUTOKUMA__SNIPPETS__LOCAL_SERVICES="
dns_iotgw.dns.name: DNS IoT GW
dns_iotgw.dns.hostname: {{ iotgw_hostname }}.{{ local_domain }}
dns_iotgw.dns.dns_resolve_server: {{ local_ip_address }}
dns_iotgw.dns.parent_name: local_services
dns_iotgw.dns.description: The gateway's DNS resolves its own name ({{ iotgw_hostname }}.{{ local_domain }}).
{% if mqtt | default(true) | bool %}

mqtt_iotgw.port.name: MQTT IoT Gateway
mqtt_iotgw.port.hostname: {{ local_ip_address }}
mqtt_iotgw.port.port: 1883
mqtt_iotgw.port.parent_name: local_services
mqtt_iotgw.port.description: The gateway's MQTT broker accepts TCP connections on port 1883.
{% endif %}
{% if obs | default(true) | bool %}

alloy.http.name: Grafana Alloy
alloy.http.url: http://{{ local_ip_address }}:12345
alloy.http.parent_name: local_services
alloy.http.description: Grafana Alloy answers HTTP on port 12345.
{% endif %}
"
