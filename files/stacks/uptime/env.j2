TZ=Europe/Madrid
UPTIME_KUMA_PORT={{ uptime_kuma_port | default('3003') }}
NUM_MAQUINA={{ num_maquina | default('0') }}
LOCAL_PREFIX="10.121.10{{ num_maquina | default('0') }}"
LOCAL_IP_ADDRESS="${LOCAL_PREFIX}.1"

# CREDENTIALS
MQTT_USERNAME={{ mqtt_username | default('debug') }}
MQTT_PASSWORD={{ mqtt_password | default('The2password.') }}

# Kuma Configuration
UPTIME_KUMA_HIDE_LOG="debug_monitor,info_monitor,warn_monitor,info_auth,info_manage,info_socket,info_rate-limit"

# Autokuma Configuration
AUTOKUMA__KUMA__URL=http://127.0.0.1:{{ uptime_kuma_port | default('3003') }}
AUTOKUMA__KUMA__USERNAME={{ autokuma_username | default('admin') }}
AUTOKUMA__KUMA__PASSWORD={{ autokuma_password | default('The2password.') }}
AUTOKUMA__DOCKER__HOSTS=unix:///var/run/docker.sock
AUTOKUMA__DOCKER__LABEL_PREFIX=kuma

{% raw %}
# Container Snippet
AUTOKUMA__SNIPPETS__CONTAINER='
{{container_name}}.docker.name: {{args[0].name}}
{{container_name}}.docker.docker_container: {{container_name}}
{{container_name}}.docker.docker_host: 1
{{container_name}}.docker.parent_name: docker_containers
{{container_name}}.docker.description: {{args[0].description | default(value=container_name)}}
'
{% endraw %}

# Local Services Snippet
AUTOKUMA__SNIPPETS__LOCAL_SERVICES="
hmi.ping.name: HMI
hmi.ping.hostname: ${LOCAL_PREFIX}.8
hmi.ping.parent_name: local_services

printer.ping.name: Printer
printer.ping.hostname: ${LOCAL_PREFIX}.20
printer.ping.parent_name: local_services

press.ping.name: PC Premsa
press.ping.hostname: ${LOCAL_PREFIX}.13
press.ping.parent_name: local_services

plc_maquina.ping.name: PLC Maquina
plc_maquina.ping.hostname: ${LOCAL_PREFIX}.11
plc_maquina.ping.parent_name: local_services

plc_premsa.ping.name: PLC Premsa
plc_premsa.ping.hostname: ${LOCAL_PREFIX}.12
plc_premsa.ping.parent_name: local_services

robot_arm.ping.name: Robot encaixat
robot_arm.ping.hostname: ${LOCAL_PREFIX}.14
robot_arm.ping.parent_name: local_services

dns_iotgw.dns.name: DNS IoT GW
dns_iotgw.dns.dns_resolve_server: ${LOCAL_PREFIX}.1
dns_iotgw.dns.hostname: {{ mqtt_hostname | default('mqtt.sabatmorrions.com') }}
dns_iotgw.dns.parent_name: local_services
dns_iotgw.dns.description: El DNS configurat al IoT Gateway és capaç de resoldre el hostname \"mqtt.sabatmorrions.com\" i el resultat obtingut és \"${LOCAL_PREFIX}.1\" que és el correcte.

mqtt_iot_gw.mqtt.name: MQTT IoT Gateway
mqtt_iot_gw.mqtt.hostname: ${LOCAL_PREFIX}.1
mqtt_iot_gw.mqtt.port: {{ mqtt_port | default('1883') }}
mqtt_iot_gw.mqtt.mqtt_username: ${MQTT_USERNAME}
mqtt_iot_gw.mqtt.mqtt_password: ${MQTT_PASSWORD}
mqtt_iot_gw.mqtt.mqtt_topic: sabat/stantoni/produccio/morrions/${NUM_MAQUINA}/comptadors
mqtt_iot_gw.mqtt.parent_name: local_services
mqtt_iot_gw.mqtt.description: Es monitoritza que el comptador que hi ha en aquest topic va creixent; per tant, el MQTT ha d'acceptar la connexió, ens hem de poder subscriure al serveri i el comptador ha de creixer. Sinó fallarà.

alloy.http.name: Grafana Alloy
alloy.http.url: http://${LOCAL_IP_ADDRESS}:12345
alloy.http.parent_name: local_services
alloy.http.description: Podem connectar via HTTP a la IP i ports indicats; si l'enllaç no s'estableix i el HTTP no retorna 20X fallarà.
"

# Factory Services Snippet
AUTOKUMA__SNIPPETS__FACTORY_SERVICES="
mqtt_factory.mqtt.name: MQTT IIoT server
mqtt_factory.mqtt.hostname: {{ factory_mqtt_host | default('192.168.1.22') }}
mqtt_factory.mqtt.parent_name: factory_services
mqtt_factory.mqtt.port: {{ mqtt_port | default('1883') }}
mqtt_factory.mqtt.mqtt_username: ${MQTT_USERNAME}
mqtt_factory.mqtt.mqtt_password: ${MQTT_PASSWORD}
mqtt_factory.mqtt.mqtt_topic: sabat/stantoni/produccio/morrions/${NUM_MAQUINA}/comptadors
mqtt_factory.mqtt.description: Es monitoritza que el comptador que hi ha en aquest servidor i aquest topic va creixent; per tant, el MQTT ha d'acceptar la connexió, ens hem de poder subscriure al serveri i el comptador ha de creixer. Sinó fallarà.

factory_gw.ping.name: Factory GW
factory_gw.ping.hostname: {{ factory_gw_host | default('192.168.4.1') }}
factory_gw.ping.parent_name: factory_services

iiot_server.ping.name: IIOT server
iiot_server.ping.hostname: {{ iiot_server_host | default('192.168.1.22') }}
iiot_server.ping.parent_name: factory_services

ad_primary.ping.name: AD factory
ad_primary.ping.hostname: {{ main_local_dns | default('192.168.1.16') }}
ad_primary.ping.parent_name: factory_services

dns_factory.dns.name: DNS factory
dns_factory.dns.hostname: {{ mqtt_hostname | default('mqtt.sabatmorrions.com') }}
dns_factory.dns.dns_resolve_server: {{ main_local_dns | default('192.168.1.16') }}
dns_factory.dns.parent_name: factory_services
dns_factory.dns.description: El DNS del AD que tenim al CPD de Sàbat és capaç de resoldre el hostname \"mqtt.sabatmorrions.com\".
"

# Cloud Services Snippet
AUTOKUMA__SNIPPETS__CLOUD_SERVICES="
ad_secundary.ping.name: AD cloud
ad_secundary.ping.hostname: {{ backup_local_dns | default('192.168.210.39') }}
ad_secundary.ping.parent_name: cloud_services

dns_cloud.dns.name: DNS cloud
dns_cloud.dns.dns_resolve_server: {{ backup_local_dns | default('192.168.210.39') }}
dns_cloud.dns.hostname: {{ mqtt_hostname | default('mqtt.sabatmorrions.com') }}
dns_cloud.dns.parent_name: cloud_services
dns_cloud.dns.description: El DNS del AD que tenim al CPD d'ANCO és capaç de resoldre el hostname \"mqtt.sabatmorrions.com\".
"

# Internet Services Snippet
AUTOKUMA__SNIPPETS__INTERNET_SERVICES="
internet.ping.name: Internet
internet.ping.hostname: {{ internet_dns | default('8.8.8.8') }}
internet.ping.parent_name: internet_services
internet.ping.description: El IoT GW és capaç d'arribar a un servidor de DNS públic.

dns_internet.dns.name: DNS internet
dns_internet.dns.dns_resolve_server: {{ internet_dns | default('8.8.8.8') }}
dns_internet.dns.hostname: {{ mqtt_hostname | default('mqtt.sabatmorrions.com') }}
dns_internet.dns.parent_name: internet_services
dns_internet.dns.description: Un DNS d'Internet és capaç de resoldre el hostname \"mqtt.sabatmorrions.com\" accedint als registres públics del nostre DNS (Google DNS).
"
