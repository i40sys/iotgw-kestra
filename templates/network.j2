
config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config globals 'globals'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth1'
	list ports 'eth2'
	list ports 'eth3'
	list ports 'eth4'
	list ports 'eth5'
	option ipv6 '0'
  option stp '0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '{{ local_ip_address }}'
	{# task-131: from local_netmask or the gateway's current value (tasks/system.yaml) #}
	option netmask '{{ iotgw_lan_netmask }}'
	option ip6assign '60'
	option delegate '0'
	list dns_search '{{ local_domain }}'

config interface 'wan'
	option device 'eth0'
	option proto 'dhcp'

config interface 'docker'
	option device 'docker0'
	option proto 'none'
	option auto '0'

config device
	option type 'bridge'
	option name 'docker0'

{# wg0 = the management VPN. The iotgw_wg0_* facts are READ BACK from the
   gateway's live config and asserted in tasks/system.yaml (task-130) — never
   operator-typed — so this rewrite re-emits exactly what the gateway runs. #}
config interface 'wg0'
        option proto 'wireguard'
        option private_key '{{ iotgw_wg0_private_key }}'
{% for a in iotgw_wg0_addresses.split() %}
        list addresses '{{ a }}'
{% endfor %}
        option metric '5'

config wireguard_wg0 'wgserver'
        option public_key '{{ iotgw_wg0_public_key }}'
        option endpoint_host '{{ iotgw_wg0_endpoint_host }}'
        option endpoint_port '{{ iotgw_wg0_endpoint_port }}'
        option persistent_keepalive '25'
        option route_allowed_ips '1'
        list allowed_ips '0.0.0.0/0'
        option description 'netmaker.example.com'

{# No route to the VPN endpoint: the iotgw agent owns it and keeps it on the
   current LAN router (iotgw-ng decision-032 §9, task-125.10). #}
